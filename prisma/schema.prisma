// TenderBase — SA public procurement tenders.
// Schema mirrors the contract the live TenderBase app already consumes
// (see RESEARCH.md section 2), so the API layer stays a thin pass-through.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Pooled connection, used by the application at runtime.
  // On Neon this is the hostname WITH the `-pooler` suffix.
  url = env("DATABASE_URL")

  // Direct (unpooled) connection, used by the Prisma CLI for migrations.
  // Neon routes pooled connections through PgBouncer in transaction mode,
  // which does not support the session-level state that DDL needs, so
  // `prisma migrate deploy` must run against the direct endpoint
  // (hostname WITHOUT `-pooler`).
  //
  // Locally both point at the same database, which is harmless.
  directUrl = env("DIRECT_URL")
}

model Tender {
  id String @id @default(cuid())

  // --- provenance / identity -------------------------------------------
  source       String @default("OCDS")
  sourceUrl    String
  ocid         String
  releaseId    String
  tenderNumber String

  // --- app-facing fields (names match the live contract) ---------------
  title        String?
  description  String?
  organisation String?
  category     String?
  province     String?
  location     String?
  valueCents   BigInt?

  publishedDate DateTime?
  closingDate   DateTime?
  status        String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  // --- enrichment -------------------------------------------------------
  /// Regex-extracted from free text; ~2.3% recall. Never a hard filter.
  cidbGrade    String?
  cidbGradeRaw String?
  /// false for "Regret Letter" / cancellation notices (not opportunities)
  isOpportunity Boolean  @default(true)

  // --- change detection -------------------------------------------------
  contentHash String

  /// Load-bearing for notifications: alerts only fire for tenders first
  /// seen AFTER a filter set was created, so a backfill never emails anyone.
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents     TenderDocument[]
  notifications Notification[]

  @@unique([source, ocid, releaseId], name: "source_ocid_releaseId")
  @@index([province, category])
  @@index([closingDate])
  @@index([publishedDate])
  @@index([status])
  @@index([firstSeenAt])
  @@index([isOpportunity, status, closingDate])
}

model TenderDocument {
  id         String  @id @default(cuid())
  tenderId   String
  name       String?
  url        String
  fileType   String?
  isAddendum Boolean @default(false)

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model ScraperRun {
  id          String  @id @default(cuid())
  source      String  @default("OCDS")
  status      String  @default("RUNNING") // RUNNING | SUCCESS | ERROR
  isBackfill  Boolean @default(false)

  dateFrom DateTime?
  dateTo   DateTime?

  pagesFetched   Int @default(0)
  fetchedCount   Int @default(0)
  insertedCount  Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  errorCount     Int @default(0)

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  durationMs Int?

  errors ScraperError[]

  @@index([startedAt])
}

model ScraperError {
  id        String   @id @default(cuid())
  runId     String?
  run       ScraperRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  url       String?
  message   String
  createdAt DateTime @default(now())

  @@index([runId])
}

// ---------------------------------------------------------------------------
// Matching + notifications (Phase 4)
// ---------------------------------------------------------------------------

/// A saved search. Match rule = province (hard filter) AND (category OR keywords).
/// The category/keyword union is deliberate: measured +28.6% recall over either
/// alone, because neither the feed's categories nor keywords cover everything.
model FilterSet {
  id     String @id @default(cuid())
  userId String
  name   String

  provinces  String[] @default([])
  categories String[] @default([])
  keywords   String[] @default([])

  notifyNewMatch Boolean  @default(true)
  notifyExpiring Boolean  @default(true)
  expiryLeadDays Int      @default(7)
  channels       String[] @default(["inapp"])
  /// Destination for email alerts. Temporary: the app owns user identity, so
  /// this will eventually come from the authenticated user record.
  notifyEmail    String?

  isActive Boolean @default(true)

  /// Doubles as the incremental cursor AND the backfill guard: a filter set
  /// never matches tenders first seen before it existed, so importing 1,845
  /// historical tenders can never email anyone.
  createdAt     DateTime  @default(now())
  lastMatchedAt DateTime?

  notifications Notification[]

  @@index([userId])
  @@index([isActive])
}

model Notification {
  id String @id @default(cuid())

  /// Explicit dedupe key rather than a nullable-column unique constraint:
  /// Postgres treats NULLs as DISTINCT, so a unique index on a nullable
  /// `closingDate` would let duplicate alerts through. See buildDedupeKey().
  dedupeKey String @unique

  filterSetId String
  filterSet   FilterSet @relation(fields: [filterSetId], references: [id], onDelete: Cascade)
  tenderId    String
  tender      Tender    @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId      String

  /// new_match | expiring
  type        String
  /// Set for `expiring` only — the deadline this alert refers to.
  closingDate DateTime?

  inappSentAt DateTime?
  pushSentAt  DateTime?
  emailSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([filterSetId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
