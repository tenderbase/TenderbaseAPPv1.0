// TenderBase — SA public procurement tenders.
// Prisma schema for Neon PostgreSQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Province {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizations Organization[]

  @@index([name])
}

model Municipality {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  province    String
  type        String  @default("LOCAL_MUNICIPALITY")
  websiteUrl  String?
  enabled     Boolean @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenders       Tender[]
  organizations Organization[]

  @@index([province, enabled])
}

model Organization {
  id            String   @id @default(cuid())
  externalId    String?
  name          String
  organizationType String?
  provinceId    String?
  municipalityId String?
  websiteUrl    String?
  source        String   @default("OCDS")
  rawData       Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  province     Province?     @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  municipality Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  buyerTenders Tender[]
  awards       TenderAward[] @relation("AwardSupplier")

  @@index([name])
  @@index([externalId])
  @@index([provinceId])
  @@index([municipalityId])
  @@unique([source, externalId], name: "organization_source_externalId")
}

model Tender {
  id String @id @default(cuid())

  source       String @default("OCDS")
  sourceUrl    String
  ocid         String
  releaseId    String
  tenderNumber String

  procurementType String @default("TENDER")

  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  buyerOrganizationId String?
  buyerOrganization   Organization? @relation(fields: [buyerOrganizationId], references: [id], onDelete: SetNull)

  title        String?
  description  String?
  organisation String?
  category     String?
  province     String?
  location     String?
  valueCents   BigInt?

  publishedDate DateTime?
  closingDate   DateTime?
  status        String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  cidbGrade    String?
  cidbGradeRaw String?
  isOpportunity Boolean @default(true)

  contentHash String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents     TenderDocument[]
  notifications Notification[]
  awards        TenderAward[]
  cancellations TenderCancellation[]
  changes       TenderChange[]
  rawReleases   RawTenderData[]

  @@unique([source, ocid, releaseId], name: "source_ocid_releaseId")
  @@index([municipalityId, procurementType])
  @@index([buyerOrganizationId])
  @@index([province, category])
  @@index([closingDate])
  @@index([publishedDate])
  @@index([status])
  @@index([firstSeenAt])
  @@index([isOpportunity, status, closingDate])
}

model TenderDocument {
  id         String  @id @default(cuid())
  tenderId   String
  name       String?
  url        String
  fileType   String?
  isAddendum Boolean @default(false)

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
}

model TenderAward {
  id             String   @id @default(cuid())
  tenderId       String
  supplierOrgId  String?
  awardId        String?
  status         String?
  amountCents    BigInt?
  currency       String?  @default("ZAR")
  awardedAt      DateTime?
  rawData        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tender      Tender       @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  supplierOrg Organization? @relation("AwardSupplier", fields: [supplierOrgId], references: [id], onDelete: SetNull)

  @@unique([tenderId, awardId], name: "tender_award_identity")
  @@index([supplierOrgId])
  @@index([awardedAt])
}

model TenderCancellation {
  id           String   @id @default(cuid())
  tenderId     String
  reason       String?
  cancelledAt  DateTime?
  rawData      Json?
  createdAt    DateTime @default(now())

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@index([tenderId])
  @@index([cancelledAt])
}

model TenderChange {
  id          String   @id @default(cuid())
  tenderId    String
  releaseId   String
  changeType  String
  changedAt   DateTime @default(now())
  contentHash String?
  summary     String?
  rawData     Json?

  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)

  @@unique([tenderId, releaseId, changeType], name: "tender_change_identity")
  @@index([tenderId, changedAt])
}

model RawTenderData {
  id        String   @id @default(cuid())
  source    String   @default("OCDS")
  ocid      String
  releaseId String
  payload   Json
  contentHash String
  fetchedAt DateTime @default(now())
  httpStatus Int?

  tenderId String?
  tender   Tender? @relation(fields: [tenderId], references: [id], onDelete: SetNull)

  @@unique([source, ocid, releaseId], name: "raw_source_ocid_releaseId")
  @@index([ocid])
  @@index([fetchedAt])
  @@index([tenderId])
}

model IngestionRun {
  id          String   @id @default(cuid())
  source      String   @default("OCDS")
  status      String   @default("RUNNING")
  isBackfill  Boolean  @default(false)
  dateFrom    DateTime?
  dateTo      DateTime?
  cursor      String?
  pagesFetched   Int @default(0)
  fetchedCount   Int @default(0)
  insertedCount  Int @default(0)
  updatedCount   Int @default(0)
  unchangedCount Int @default(0)
  errorCount     Int @default(0)
  startedAt   DateTime @default(now())
  finishedAt  DateTime?
  durationMs  Int?
  lastReleaseAt DateTime?
  errorMessage String?

  errors IngestionError[]

  @@index([source, status, startedAt])
  @@index([lastReleaseAt])
}

model IngestionError {
  id        String   @id @default(cuid())
  runId     String
  ocid      String?
  releaseId String?
  url       String?
  message   String
  details   Json?
  createdAt DateTime @default(now())

  run IngestionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([createdAt])
}

// Legacy ingestion telemetry retained for compatibility with the current app.
model ScraperRun {
  id          String  @id @default(cuid())
  source      String  @default("OCDS")
  status      String  @default("RUNNING")
  isBackfill  Boolean @default(false)
  dateFrom DateTime?
  dateTo   DateTime?
  pagesFetched Int @default(0)
  fetchedCount Int @default(0)
  insertedCount Int @default(0)
  updatedCount Int @default(0)
  unchangedCount Int @default(0)
  errorCount Int @default(0)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?
  errors ScraperError[]
  @@index([startedAt])
}

model ScraperError {
  id String @id @default(cuid())
  runId String?
  run ScraperRun? @relation(fields: [runId], references: [id], onDelete: Cascade)
  url String?
  message String
  createdAt DateTime @default(now())
  @@index([runId])
}

model FilterSet {
  id String @id @default(cuid())
  userId String
  name String
  provinces String[] @default([])
  categories String[] @default([])
  keywords String[] @default([])
  notifyNewMatch Boolean @default(true)
  notifyExpiring Boolean @default(true)
  expiryLeadDays Int @default(7)
  channels String[] @default(["inapp"])
  notifyEmail String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  lastMatchedAt DateTime?
  notifications Notification[]
  @@index([userId])
  @@index([isActive])
}

model Notification {
  id String @id @default(cuid())
  dedupeKey String @unique
  filterSetId String
  filterSet FilterSet @relation(fields: [filterSetId], references: [id], onDelete: Cascade)
  tenderId String
  tender Tender @relation(fields: [tenderId], references: [id], onDelete: Cascade)
  userId String
  type String
  closingDate DateTime?
  inappSentAt DateTime?
  pushSentAt DateTime?
  emailSentAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
  @@index([filterSetId])
}

model PushSubscription {
  id String @id @default(cuid())
  userId String
  endpoint String @unique
  p256dh String
  auth String
  userAgent String?
  createdAt DateTime @default(now())
  @@index([userId])
}
