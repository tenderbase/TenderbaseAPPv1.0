# ---------------------------------------------------------------------------
# Copy to .env for local development:  cp .env.example .env
# Only DATABASE_URL and DIRECT_URL are required; everything else degrades
# gracefully when unset.
# ---------------------------------------------------------------------------

# --- database ---------------------------------------------------------------
# TWO connection strings, because Neon puts PgBouncer in front of the pooled
# one. PgBouncer's transaction mode does not preserve the session state that
# DDL needs, so migrations must use the DIRECT endpoint. schema.prisma wires
# these up as `url` (pooled) and `directUrl` (direct).

# POOLED — used by the running application. Hostname contains `-pooler`.
# DATABASE_URL="postgresql://user:pass@ep-cool-name-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# DIRECT — used by `prisma migrate deploy`. Hostname has NO `-pooler`.
# DIRECT_URL="postgresql://user:pass@ep-cool-name.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Local development: both point at the same database, which is fine.
DATABASE_URL="postgresql://tenderbase:tenderbase@127.0.0.1:5432/tenderbase?schema=public"
DIRECT_URL="postgresql://tenderbase:tenderbase@127.0.0.1:5432/tenderbase?schema=public"

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# --- API --------------------------------------------------------------------
# Comma-separated CORS allow-list. Defaults to "*" when unset.
CORS_ORIGINS="http://localhost:3000,https://tenderbase-web.onrender.com"

# Optional. When set, every endpoint EXCEPT /health requires
#   X-API-Key: <value>      or      Authorization: Bearer <value>
# Leave unset for an open read-only API.
# API_KEY=""

# --- notifications: email (Resend) ------------------------------------------
# Key from https://resend.com/api-keys. Unset => email is skipped, and the
# dispatcher reports 0 rather than recording a false "sent".
RESEND_API_KEY=""
# Must be a domain you have verified in Resend, otherwise sends are rejected.
EMAIL_FROM="TenderBase <alerts@tenderbase.example>"
# Address used by `npm run notify -- --seed` for the demo filter set.
DEMO_EMAIL=""

# --- notifications: web push (VAPID) ----------------------------------------
# Generate a pair with:   npx web-push generate-vapid-keys
# Unset => push is skipped.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact address the push service can reach you on (mailto: or https:).
VAPID_SUBJECT="mailto:ops@tenderbase.example"

# --- hourly job -------------------------------------------------------------
# How many days back each hourly poll re-checks. 7 rather than 1 because
# National Treasury occasionally publishes releases dated several days back.
INGEST_WINDOW_DAYS=7
